extends layout.pug
include mixins/window.pug

block params
  - var active='window.html'
  - var title='Windows'

block content
  .pdn.demo-stack
    +window('My Documents', {icon: 'folder-open'})
      ul.menubar
        li.menubar-item(tabindex='0') <u>F</u>ile
        li.menubar-item(tabindex='0') <u>E</u>dit
        li.menubar-item(tabindex='0') <u>V</u>iew
        li.menubar-item(tabindex='0') <u>H</u>elp
      .window-content(style='height: 120px')
        .pdn
          span.icon.icon-document
          |  readme.txt
      .statusbar
        span.statusbar-panel 1 object(s)
        span.statusbar-panel 1.2 KB
        span.statusbar-grip

    .demo-row
      +window('Inactive window', {icon: 'computer', inactive: true, style: 'width: 260px'})
        .window-body Not focused.
      +window('Tool window', {class: 'window-tool', dialog: true, style: 'width: 180px'})
        .window-body Palette
      +window('Properties', {dialog: true, help: true, style: 'width: 220px'})
        .window-body Dialog with help button.

    .demo-heading Resizable
    +window('Notepad', {icon: 'document', style: 'width: 300px; padding-bottom: 20px'})
      textarea(style='width: 100%; height: 80px') Drag the grip…
      span.window-resize-grip
